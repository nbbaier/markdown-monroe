{
	"manifest_version": 3,
	"name": "Markdown Monroe",
	"version": "0.1.0",
	"description": "A glamorous interactive viewer for Markdown responses.",
	"browser_specific_settings": {
		"gecko": {
			"id": "markdown-monroe@local",
			"strict_min_version": "109.0"
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"permissions": ["storage"],
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"],
			"css": ["content.css"],
			"run_at": "document_end"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["content.css"],
			"matches": ["<all_urls>"]
		}
	]
}
